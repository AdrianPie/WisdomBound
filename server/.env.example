# AI quiz server (Ktor) - copy to server/.env or set these in your host (e.g. Cloud Run).
# Never commit real values. Only one AI provider key is needed; Gemini wins when both are set.

PORT=8080

# Firebase project whose ID tokens the server accepts and whose Firestore stores AI usage.
# Admin credentials come from Application Default Credentials:
#   locally:   gcloud auth application-default login
#   Cloud Run: the service account of the service
FIREBASE_PROJECT_ID=your-firebase-project-id

# AI provider (pick one)
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# RevenueCat SECRET key (server only). Used to check the "premium" entitlement before
# spending AI credits. Leave empty to treat everyone as non-premium.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=premium

# Monthly AI deck generations for premium users
AI_QUOTA_LIMIT_PER_MONTH=200
